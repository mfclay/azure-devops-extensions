{
  "name": "@pipeline-insights/core",
  "version": "0.1.3",
  "description": "Pipeline Insights rules and parsing: state model, attention rules, metadata, line inference. No network, no Azure DevOps SDK.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "capture-fixture": "vite-node capture/capture-fixture.ts",
    "fixture": "vite-node fixtures/write-contoso.ts"
  },
  "dependencies": {
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite-node": "^3.2.4"
  }
}
