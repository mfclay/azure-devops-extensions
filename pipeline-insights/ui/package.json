{
  "name": "@pipeline-insights/ui",
  "version": "0.1.3",
  "description": "The Pipeline Insights page as React components, themed by the host through --pi-* CSS variables.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace @pipeline-insights/core",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build --workspace @pipeline-insights/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build --workspace @pipeline-insights/core",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pipeline-insights/core": "0.1.3"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
