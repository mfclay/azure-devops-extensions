# Editor window tinting, per-machine and personal — not project config.
.vscode/

# The release publisher, filled in by hand and never committed: extension identity is
# {publisher}.{id}, so committing one makes the dev-to-release swap a silent change of
# identity rather than a deliberate act. The .example alongside it is the template.
extension/overrides/release.json
# The per-run overrides publish-dev and the publish workflow stage, with the version filled in.
extension/overrides/.staged-dev.json
extension/overrides/.staged-release.json
test-results.xml

# Recordings of real projects, from `npm run capture-fixture`. Never committed.
core/fixtures/recorded/
