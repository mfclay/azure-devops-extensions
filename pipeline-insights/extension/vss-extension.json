{
  "manifestVersion": 1,
  "id": "pipeline-insights",
  "version": "0.1.0",
  "name": "Pipeline Insights",
  "description": "One page for a project's pipelines: what needs attention, how they're doing overall, and every pipeline's recent runs.",
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "pipelines",
    "insights",
    "dashboard",
    "approvals",
    "health"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "images/icon-128.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "links": {
    "repository": {
      "uri": "https://github.com/mfclay/azure-devops-extensions/tree/main/pipeline-insights"
    },
    "issues": {
      "uri": "https://github.com/mfclay/azure-devops-extensions/issues"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/mfclay/azure-devops-extensions/tree/main/pipeline-insights"
  },
  "branding": {
    "color": "#AEDFE5",
    "theme": "light"
  },
  "scopes": [
    "vso.build",
    "vso.code"
  ],
  "files": [
    {
      "path": "hub",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "insights-hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-build-web.build-release-hub-group"
      ],
      "properties": {
        "name": "Insights",
        "uri": "hub/index.html",
        "iconName": "AnalyticsView",
        "order": 100
      }
    }
  ]
}
