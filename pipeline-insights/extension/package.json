{
  "name": "@pipeline-insights/extension",
  "version": "0.1.0",
  "description": "The Pipeline Insights Azure DevOps extension: manifest, hub entry point, Azure DevOps data source, packaging.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @pipeline-insights/ui",
    "build": "tsc -p tsconfig.json && vite build",
    "prebuild:demo": "npm run build --workspace @pipeline-insights/ui",
    "build:demo": "tsc -p tsconfig.json && vite build --mode demo",
    "package": "node scripts/package.mjs",
    "pretest": "npm run build --workspace @pipeline-insights/ui",
    "test": "vitest run",
    "precoverage": "npm run build --workspace @pipeline-insights/ui",
    "coverage": "vitest run --coverage",
    "pretypecheck": "npm run build --workspace @pipeline-insights/ui",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pipeline-insights/core": "0.1.3",
    "@pipeline-insights/ui": "0.1.3",
    "azure-devops-extension-sdk": "^4.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tfx-cli": "^0.24.0",
    "vite": "^8.2.2"
  }
}
