{
  "name": "@bicep-whatif/ui",
  "version": "0.1.0",
  "description": "Build-results tab for the Azure Deployment Stacks what-if viewer. Static React 19 SPA.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build --workspace @bicep-whatif/core",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "pretest": "npm run build --workspace @bicep-whatif/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build --workspace @bicep-whatif/core",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bicep-whatif/core": "0.1.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "azure-devops-extension-api": "^5.276.0",
    "azure-devops-extension-sdk": "^4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^27.0.0",
    "vite": "^8.2.2"
  }
}
